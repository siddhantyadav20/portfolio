# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...but the template carries no secrets and is the only record of which
# variables the app reads.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Source material: Figma exports, the Framer originals, the raw inspection
# recording. ~110MB, imported by nothing, excluded from typecheck and lint —
# but cloned in full on every CI run. The single .mov in here is 45MB, about a
# third of .git on its own.
#
# Adding this line does not untrack what is already committed. To stop
# carrying it forward:
#     git rm -r --cached references
# Removing it from *history* is a rewrite and is not something to do casually.
/references

# Not source material and not ours — an APK that landed in references/photos.
*.apk
