# Copy to `.env.local` and fill in. Nothing here is required to run the site
# locally — every value has a working fallback — but the waitlist silently
# logs instead of mailing until RESEND_API_KEY is set.

# The canonical origin, used for metadataBase, OG image URLs, the sitemap and
# robots.txt. Unset, these fall back to the production domain — which is wrong
# on a preview deployment, and used to happen silently. A build with CI=true
# and this unset now fails rather than publishing production URLs from a
# non-production deploy. `next dev` and a local `next build` still use the
# fallback.
NEXT_PUBLIC_SITE_URL=https://siddhantyadav.com

# Waitlist mail (components/home/StoreWaitlist/submit.ts).
# Required for a submission to actually leave the server; without it the entry
# is written to the server log in development and dropped in production.
RESEND_API_KEY=

# Optional. Defaults are in submit.ts.
WAITLIST_TO=
WAITLIST_FROM=

# Where the site reports Core Web Vitals and unhandled errors. Optional, and
# unset means nothing is ever sent — see lib/telemetry.ts. Any endpoint that
# accepts a JSON POST will do; the payload carries no identifier of any kind.
NEXT_PUBLIC_TELEMETRY_URL=

# Reactions and comments on a case study (lib/upstash.ts).
#
# In production these are injected automatically by the Upstash database added
# through the Vercel Marketplace — nothing needs pasting, which is the reason
# to add it that way. `lib/upstash.ts` also accepts the KV_REST_API_* pair,
# because some marketplace flows still use Vercel KV's names for the same two
# values.
#
# Locally, copy them out of the Upstash console into `.env.local`. Unset,
# every study still renders and the engagement block says plainly that it is
# not connected rather than showing zeroes.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional. Salts the hash that stands in for a voter's identity, so the store
# holds no IP addresses. Changing it resets who has already reacted; it does
# not reset the counts.
ENGAGEMENT_SALT=
